<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sesli komut: yalnızca kullanıcı KONUŞ düğmesine bastığında (çalışma zamanı izni) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Gemini API ve (cihaza göre) konuşma tanıma -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sesli oturum / uyandırma sözcüğü için ön plan hizmeti (Android 14+ türü: microphone) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Ön plan hizmeti bildirimi (Android 13+ çalışma zamanı izni) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Bugün ne yapmam gerekiyor?" — yalnızca kullanıcı ajandasını sorduğunda istenir, yalnızca okuma -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Saat uygulamasında alarm/zamanlayıcı hazırlama (normal izin) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Android 11+ paket görünürlüğü: yalnızca başlatıcıda görünen uygulamaları listelemek için -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEARCH" />
        </intent>
        <package android:name="com.google.android.youtube" />
    </queries>

    <application
        android:name=".JarvisApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FKJarvis">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sesli oturum ve "JARVIS" uyandırma sözcüğü (bildirimli ön plan hizmeti) -->
        <service
            android:name=".service.AssistantSessionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Seviye B ekran etkileşimi: kullanıcı Ayarlar > Erişilebilirlik'ten kendisi açar -->
        <service
            android:name=".accessibility.JarvisAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
