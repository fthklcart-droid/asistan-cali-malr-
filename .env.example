# --- Claude (görev planlama) ---
# https://console.anthropic.com adresinden alınan API anahtarı
ANTHROPIC_API_KEY=
# Boş bırakılırsa claude-opus-5-5 kullanılır
ANTHROPIC_MODEL=

# --- Yerel köprü (yalnızca bu bilgisayardan erişilir) ---
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# --- Gemini Live API - gerçek zamanlı Türkçe sesli görüşme ---
# https://aistudio.google.com/apikey adresinden alınan API anahtarı
GEMINI_API_KEY=
# Boş bırakılırsa sırayla denenir: gemini-3.1-flash-live-preview,
# gemini-2.5-flash-native-audio-preview-12-2025, gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_LIVE_MODEL=
GEMINI_VOICE_NAME=Kore

# --- Ses aygıtları (boş = Windows varsayılanı; Ayarlar sekmesinden seçilebilir) ---
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# --- Sohbet ve bilgisayar kontrolü ---
# Sohbet yanıt derinliği: low (hızlı) / medium / high
JARVIS_CHAT_EFFORT=low
# Bilgisayar kontrolü derinliği: medium / high / xhigh
JARVIS_AGENT_EFFORT=high
# Dosya becerilerinin okuyabileceği ek klasörler (; ile ayırın). Kullanıcı klasörü zaten izinlidir.
JARVIS_EXTRA_FOLDERS=

# --- WhatsApp Business Cloud API (Meta for Developers > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=

# --- YouTube Data API (Google Cloud Console > OAuth istemcisi: Masaüstü uygulaması) ---
YOUTUBE_CLIENT_SECRET_FILE=
