# --- Claude (görev planlama) ---
# https://console.anthropic.com adresinden alınan API anahtarı
ANTHROPIC_API_KEY=
# Boş bırakılırsa claude-opus-5-5 kullanılır
ANTHROPIC_MODEL=

# --- Yerel köprü (yalnızca bu bilgisayardan erişilir) ---
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# --- Gemini Live API - gerçek zamanlı Türkçe sesli görüşme ---
# https://aistudio.google.com/apikey adresinden alınan API anahtarı
GEMINI_API_KEY=
# Boş bırakılırsa sırayla denenir: gemini-3.1-flash-live-preview,
# gemini-2.5-flash-native-audio-preview-12-2025, gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_LIVE_MODEL=
GEMINI_VOICE_NAME=Kore
